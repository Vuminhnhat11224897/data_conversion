# Cấu hình luồng chuyển đổi v3. Chép thành .env rồi điền.
# Không dùng dấu nháy quanh giá trị (docker --env-file không bỏ dấu nháy).

# Elasticsearch nguồn: CHỈ ĐỌC. Công cụ từ chối mọi lệnh ghi lên cụm này.
SOURCE_ES_URL=http://10.1.10.10:9200
SOURCE_DOCUMENT_INDEX=legal-docs
SOURCE_CHUNK_INDEX=legal-chunk-section-v2
SOURCE_CHANGE_INDEX=legal-changed-v2

# Elasticsearch đích: chỉ ghi được 3 index dưới đây. Ba tên khác nhau, cùng đuôi -v3 (hợp đồng) hoặc cùng đuôi -v4 (ghi thử),
# không trùng index nguồn (config.Config.validate). Ghi thử v4: export TARGET_*_INDEX=...-v4 trong shell, không sửa file này.
TARGET_ES_URL=http://10.1.10.23:9200
TARGET_DOCUMENT_INDEX=legal-docs-v3
TARGET_CHUNK_INDEX=legal-chunk-section-v3
TARGET_CHANGE_INDEX=legal-changed-v3

# Model LLM (API kiểu OpenAI): hỏi tên Điều, rà bố cục, trích quan hệ (tầng 2), QA quan hệ.
# Server hiện tại (27/10/2026): SGLang trên máy dell-ai, qua Tailscale. Không cần khóa: đặt LITELLM_API_KEY=EMPTY.
LITELLM_BASE_URL=http://100.91.202.88:8012/v1
LITELLM_API_KEY=EMPTY
LITELLM_MODEL=qwen3.6-35b

# Múi giờ của LLM_NIGHT_HOURS. Máy chủ và container mặc định UTC: thiếu dòng này thì 22h-6h bị hiểu là 5h-13h giờ Việt Nam.
TZ=Asia/Ho_Chi_Minh
# Số lời gọi LLM cùng lúc trong một tiến trình: ban ngày 3; trong LLM_NIGHT_HOURS (22h đến 6h) 10.
LLM_CONCURRENCY_DAY=3
LLM_CONCURRENCY_NIGHT=10
LLM_NIGHT_HOURS=22-6
# Trần max_tokens mỗi lời gọi. Timeout: kết nối 5 s; đọc 30 s, dài hơn khi câu trả lời có thể dài (max_tokens / LLM_MIN_TOKENS_PER_SECOND).
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_CONNECT=5
LLM_TIMEOUT_READ=30
LLM_MIN_TOKENS_PER_SECOND=20
# Server từ chối kết nối khi bận: chờ rồi thử lại (giây, mỗi lần một số).
LLM_CONNECT_RETRY_WAITS=10,20,40,60,90
# Chạy lại chặt: strict = chỉ dùng câu trả lời model đã lưu, không gọi model; thiếu câu trả lời thì văn bản lỗi (ReplayMiss).
# Chỉ đặt cho một lần chạy (eval.replay tự đặt). Để trống hoặc không đặt khi chạy thường.
# LLM_REPLAY=strict

# Dịch vụ embedding BAAI/bge-m3, 1024 chiều. Có hai loại:
# - API kiểu OpenAI (vLLM): EMBEDDING_URL kết thúc bằng /v1, ví dụ http://10.1.10.22:9999/v1. Cần EMBEDDING_KEY.
#   Gửi 32 đến 48 đoạn mỗi request (EMBEDDING_BATCH). Kiểm bằng: python -m vbpl_v3 check.
# - Dịch vụ cũ (POST /embed): ví dụ EMBEDDING_URL=http://<máy chủ>:8989. Dịch vụ này cắt ở 256 token.
EMBEDDING_URL=
EMBEDDING_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH=64
# Số token đầu của mỗi chunk được embed (chỉ API kiểu OpenAI). Để trống: cả chunk (server cắt ở 8192 token).
# 256: cùng không gian với vector của index v2, v3.
EMBEDDING_TRUNCATE=
# yes: chunk có cùng chuỗi tieu_de + noi_dung với chunk nguồn thì dùng lại vector nguồn.
# Đặt no nếu dịch vụ embedding khác cấu hình đã tạo vector nguồn (kiểm bằng: check --vectors 50).
# Vector nguồn v2 là 256 token đầu: API kiểu OpenAI với EMBEDDING_TRUNCATE trống phải đặt no (config từ chối yes).
# target: khi ghi lại -v4, chunk không đổi chữ thì dùng lại vector đủ độ dài đang có ở index đích.
#   Cần API /v1 và EMBEDDING_TRUNCATE trống (config từ chối cách khác). Lượt ghi lại v4-2710 (28/10/2026) dùng target.
# Lượt văn bản mới ghi -v4 (vector đủ độ dài) đặt no.
EMBEDDING_REUSE=yes

# Thư mục nhật ký và cache phản hồi model (tương đối so với data_vbpl_v3/).
V3_WORKDIR=work

QA_MAX_TOKENS=512
QA_SCOPE_MAX_TOKENS=1024

# Năm bắt đầu: chỉ bóc văn bản có ngày ký/ban hành HOẶC ngày hiệu lực từ 1/1 của năm này trở đi. Sớm hơn thì bỏ qua (ghi skipped).
START_YEAR=1980

# Cách dò quan hệ: llm (4 tầng, luồng chốt 20/10/2026, docs/08) hoặc rules (regex và QA, luồng cũ).
RELATION_EXTRACTOR=llm
# Chạy liên tục (python -m vbpl_v3 auto): số luồng = số lời gọi LLM cùng lúc (LLM_CONCURRENCY_DAY/NIGHT).
# Mỗi lô có AUTO_BATCH_PER_WORKER văn bản cho mỗi luồng (ngày 1 x 25, đêm 12 x 25 = 300); quét lại nguồn mỗi AUTO_RESCAN_HOURS giờ;
# văn bản lỗi AUTO_MAX_ATTEMPTS lần thì loại (work/auto/excluded.json).
AUTO_BATCH_PER_WORKER=25
AUTO_RESCAN_HOURS=24
AUTO_MAX_ATTEMPTS=3

